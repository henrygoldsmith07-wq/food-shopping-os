{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "checkJs": false,
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": ["src/typed/**/*.ts", "src/server/schemas.ts", "tests/typed/**/*.test.ts"],
  "exclude": ["node_modules", ".next"]
}
