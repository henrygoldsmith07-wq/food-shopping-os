# Forq backend — copy to .env.local and fill in only what you need.
# The app runs local-only with everything unset; each section below is opt-in.
# See README "Backend setup" and src/server/env.js (the deployment contract).

# --- App URL (metadata links) ---
# APP_PUBLIC_URL=https://food-shopping-os.vercel.app

# --- Auth (Auth.js). AUTH_SECRET is required for any OAuth provider. ---
# Generate: openssl rand -base64 32
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=
# AUTH_MICROSOFT_ID=
# AUTH_MICROSOFT_SECRET=
# AUTH_MICROSOFT_TENANT_ID=

# --- Database (Upstash Redis; KV_* are the current names, UPSTASH_* are legacy aliases) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_PREFIX=

# --- Realtime (optional; falls back to Redis stream) ---
# ABLY_API_KEY=

# --- AI relay: free ladder first (NVIDIA NIM, then OpenRouter), paid OpenAI relay last ---
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# AI_MONTHLY_TOKEN_LIMIT=250000

# --- Preview-only sign-in (local dev-preview bridge, never production) ---
# AUTH_DEV_LOGIN=false

# --- Batch classifier (free tier, keyless; disabled falls back to deterministic rules) ---
# CLASSIFIER_API_URL=
# CLASSIFIER_API_KEY=
# CLASSIFIER_DISABLED=false
# CLASSIFIER_TIER=fast
# CLASSIFIER_CONFIDENCE_FLOOR=0.5
# CLASSIFIER_TIMEOUT_MS=8000

# --- Private receipt uploads ---
# BLOB_READ_WRITE_TOKEN=

# --- Live price scraper ladder (monid,direct,firecrawl,jina) ---
# PRICE_SCRAPER_ENABLED=true
# PRICE_SCRAPER_STRATEGIES=monid,direct,firecrawl,jina
# PRICE_SCRAPER_MARKET=auto
# PRICE_SCRAPER_RETAILERS=
# PRICE_SCRAPER_CONCURRENCY=
# SCRAPER_TIMEOUT_MS=9000
# SCRAPER_RENDER_TIMEOUT_MS=25000
# SCRAPER_USER_AGENT=
# SCRAPER_MODEL_TIMEOUT_MS=
# SCRAPE_BATCH_BUDGET_MS=40000
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# FIRECRAWL_WAIT_MS=2500
# JINA_API_KEY=
# JINA_READER_BASE_URL=
# JINA_READER_ENABLED=true

# --- Monid scraping rung + Google Shopping market fallback ---
# MONID_API_KEY=
# MONID_API_BASE_URL=
# MONID_SCRAPE_PROVIDER=context.dev
# MONID_SCRAPE_ENDPOINT=/web/scrape/html
# MONID_SCRAPE_QUERY_JSON={"url":"{{url}}","country":"gb","maxAgeMs":0,"waitForMs":10000}
# MONID_SCRAPE_INPUT_JSON=
# MONID_SCRAPE_PATH_JSON=
# MONID_RUN_TIMEOUT_MS=60000
# MONID_MARKET_PROVIDER=apify
# MONID_MARKET_ENDPOINT=/burbn/google-shopping-scraper
# MONID_MARKET_INPUT_JSON={"searchQuery":"{{query}}","country":"gb","language":"en","maxResults":10}
# MONID_MIN_BALANCE=
# MONID_POLL_MS=
# MONID_CLI_ROOT=
# MONID_DISABLED=
# MONID_FORCE_CONFIGURED=
# MONID_STATE_FILE=
# SCRAPE_DIAGNOSE_BUDGET_MS=

# --- Open product data (barcode + community prices; explicit user action only) ---
# OPEN_FOOD_FACTS_ENABLED=true
# OPEN_FOOD_FACTS_API_BASE_URL=
# OPEN_FOOD_FACTS_USER_AGENT=
# OPEN_FOOD_FACTS_SEARCH_URL=https://search.openfoodfacts.org
# OPEN_PRICES_ENABLED=true
# OPEN_PRICES_API_BASE_URL=
